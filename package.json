{
  "name": "pr-gate",
  "version": "1.0.0-alpha",
  "description": "A deterministic, language-agnostic GitHub Action that flags pull requests touching project-declared \"protected\" files (tests, lint config, CI) for mandatory human review.",
  "keywords": [
    "github-action",
    "pull-request",
    "guardrails",
    "code-review",
    "ci",
    "protected-files"
  ],
  "license": "GPL-3.0-only",
  "author": "CalixtoTheBugHunter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalixtoTheBugHunter/prgate.git"
  },
  "bugs": {
    "url": "https://github.com/CalixtoTheBugHunter/prgate/issues"
  },
  "homepage": "https://github.com/CalixtoTheBugHunter/prgate#readme",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --sourcemap --outfile=dist/index.js",
    "package": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
